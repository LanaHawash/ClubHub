generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum AccountRole {
  STUDENT
  CLUB
  SUPERVISOR
  DEANSHIP
}

enum AccountStatus {
  ACTIVE
  DISABLED
}

enum ClubClassification {
  GENERAL
  FACULTY_BASED
  MAJOR_BASED
}

enum ClubStatus {
  ACTIVE
  ARCHIVED
}

enum MembershipRegistrationMode {
  ALWAYS_OPEN
  WINDOWED
}

enum MembershipApplicationKind {
  ORDINARY
  BOARD_ONBOARDING
}

enum MembershipFeeType {
  FIRST_TIME
  RENEWAL
}

enum MembershipApplicationStatus {
  PENDING_PAYMENT
  PAYMENT_PROCESSING
  PAID
  EXPIRED
  CANCELED
}

enum PaymentMethod {
  IN_PERSON
  ONLINE
}

enum PaymentStatus {
  AWAITING_CASH
  PROCESSING
  CONFIRMED
  FAILED
  EXPIRED
  REFUND_REQUIRED
  REFUNDED
}

enum PaymentProvider {
  MANUAL
  SIMULATED
  REAL_GATEWAY
}

enum PaymentAttemptStatus {
  INITIATED
  PROCESSING
  SUCCEEDED
  FAILED
  EXPIRED
  UNKNOWN
  LATE_SUCCESS_REFUND_REQUIRED
  REFUNDED
}

enum BoardNominationStatus {
  PENDING_PAYMENT
  PAYMENT_PROCESSING
  QUALIFIED
  EXPIRED
  WITHDRAWN
}

enum BoardNominationReason {
  NO_MEMBERSHIP
  INSUFFICIENT_COVERAGE
}

enum ApplicationEndReason {
  TIMEOUT
  WINDOW_CLOSED
  EARLY_WINDOW_CLOSE
  POLICY_SWITCH
  CLUB_ARCHIVED
  NOMINATION_TIMEOUT
  WITHDRAWN
  PAYMENT_FAILED
}

enum PaymentProviderEventStatus {
  RECEIVED
  APPLIED
  IGNORED
  RECONCILIATION_REQUIRED
}

model Faculty {
  id          String              @id @default(uuid()) @db.Uuid
  name        String              @unique @db.VarChar(150)
  majors      Major[]
  clubs       Club[]
  supervisors SupervisorProfile[]
  createdAt   DateTime            @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime            @updatedAt @db.Timestamptz(6)
}

model Major {
  id                 String              @id @default(uuid()) @db.Uuid
  name               String              @db.VarChar(150)
  facultyId          String              @db.Uuid
  faculty            Faculty             @relation(fields: [facultyId], references: [id], onDelete: Restrict)
  universityStudents UniversityStudent[]
  eligibleClubs      ClubEligibleMajor[]
  createdAt          DateTime            @default(now()) @db.Timestamptz(6)
  updatedAt          DateTime            @updatedAt @db.Timestamptz(6)

  @@unique([facultyId, name])
}

model UniversityStudent {
  id                     String                  @id @default(uuid()) @db.Uuid
  universityId           String                  @unique @db.VarChar(20)
  email                  String                  @unique @db.VarChar(255)
  fullName               String                  @db.VarChar(150)
  majorId                String                  @db.Uuid
  major                  Major                   @relation(fields: [majorId], references: [id], onDelete: Restrict)
  account                Account?
  boardAppointments      BoardAppointment[]
  verifications          EmailVerification[]
  createdAt              DateTime                @default(now()) @db.Timestamptz(6)
  updatedAt              DateTime                @updatedAt @db.Timestamptz(6)
  memberships            Membership[]
  membershipApplications MembershipApplication[]
  boardNominations       BoardNomination[]
}

model Account {
  id                           String                     @id @default(uuid()) @db.Uuid
  email                        String                     @unique @db.VarChar(255)
  passwordHash                 String                     @db.VarChar(255)
  role                         AccountRole
  status                       AccountStatus              @default(ACTIVE)
  universityStudentId          String?                    @unique @db.Uuid
  universityStudent            UniversityStudent?         @relation(fields: [universityStudentId], references: [id], onDelete: Restrict)
  profilePhotoUrl              String?                    @db.Text
  eventRegistrations           EventRegistration[]
  refreshSessions              RefreshSession[]
  passwordResets               PasswordResetToken[]
  supervisorProfile            SupervisorProfile?
  clubAdminAssignments         ClubAdminAssignment[]      @relation("ClubAdminStudent")
  createdMembershipFeeVersions ClubMembershipFeeVersion[]
  clubAdminAssignmentsGranted  ClubAdminAssignment[]      @relation("ClubAdminAssignedBy")

  clubAdminAssignmentsRevoked ClubAdminAssignment[] @relation("ClubAdminRevokedBy")
  confirmedPayments           Payment[]             @relation("PaymentConfirmedBy")
  boardNominations            BoardNomination[]     @relation("BoardNominatedBy")
  createdAt                   DateTime              @default(now()) @db.Timestamptz(6)
  updatedAt                   DateTime              @updatedAt @db.Timestamptz(6)
}

model EmailVerification {
  id                  String            @id @default(uuid()) @db.Uuid
  universityStudentId String            @db.Uuid
  universityStudent   UniversityStudent @relation(fields: [universityStudentId], references: [id], onDelete: Restrict)
  codeHash            String            @db.VarChar(255)
  expiresAt           DateTime          @db.Timestamptz(6)
  usedAt              DateTime?         @db.Timestamptz(6)
  attemptCount        Int               @default(0)
  createdAt           DateTime          @default(now()) @db.Timestamptz(6)
  updatedAt           DateTime          @updatedAt @db.Timestamptz(6)

  @@index([universityStudentId, expiresAt])
}

model Club {
  id                     String                     @id @default(uuid()) @db.Uuid
  name                   String                     @unique @db.VarChar(150)
  description            String                     @db.Text
  logoUrl                String?                    @db.Text
  classification         ClubClassification
  facultyId              String?                    @db.Uuid
  faculty                Faculty?                   @relation(fields: [facultyId], references: [id], onDelete: Restrict)
  supervisorId           String?                    @db.Uuid
  supervisor             SupervisorProfile?         @relation(fields: [supervisorId], references: [id], onDelete: Restrict)
  adminAssignments       ClubAdminAssignment[]
  boardAppointments      BoardAppointment[]
  status                 ClubStatus                 @default(ACTIVE)
  foundedYear            Int?
  contactEmail           String                     @db.VarChar(255)
  meetingInfo            String?                    @db.Text
  eligibleMajors         ClubEligibleMajor[]
  labels                 ClubLabel[]
  events                 Event[]
  membershipSettings     ClubMembershipSettings?
  membershipFeeVersions  ClubMembershipFeeVersion[]
  registrationWindows    ClubRegistrationWindow[]
  membershipApplications MembershipApplication[]
  boardNominations       BoardNomination[]
  createdAt              DateTime                   @default(now()) @db.Timestamptz(6)
  updatedAt              DateTime                   @updatedAt @db.Timestamptz(6)
  memberships            Membership[]

  @@index([status, name])
}

model ClubEligibleMajor {
  id        String   @id @default(uuid()) @db.Uuid
  clubId    String   @db.Uuid
  majorId   String   @db.Uuid
  club      Club     @relation(fields: [clubId], references: [id], onDelete: Restrict)
  major     Major    @relation(fields: [majorId], references: [id], onDelete: Restrict)
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  @@unique([clubId, majorId])
}

model Label {
  id        String      @id @default(uuid()) @db.Uuid
  name      String      @unique @db.VarChar(80)
  clubs     ClubLabel[]
  createdAt DateTime    @default(now()) @db.Timestamptz(6)
  updatedAt DateTime    @updatedAt @db.Timestamptz(6)
}

model ClubLabel {
  id        String   @id @default(uuid()) @db.Uuid
  clubId    String   @db.Uuid
  labelId   String   @db.Uuid
  club      Club     @relation(fields: [clubId], references: [id], onDelete: Restrict)
  label     Label    @relation(fields: [labelId], references: [id], onDelete: Restrict)
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  @@unique([clubId, labelId])
}

enum EventCategory {
  WORKSHOP
  SEMINAR
  CAMPAIGN
  CONFERENCE
  SOCIAL
  VOLUNTEERING
  OTHER
}

enum EventStatus {
  DRAFT
  PUBLISHED
  CANCELLED
}

enum EventEligibility {
  ALL_STUDENTS
  CLUB_MEMBERS
}

enum EventRegistrationStatus {
  CONFIRMED
  PENDING_PAYMENT
  CANCELLED
}

enum EventPaymentStatus {
  NOT_REQUIRED
  PENDING
  PAID
  FAILED
  REFUNDED
}

model Event {
  id String @id @default(uuid()) @db.Uuid

  clubId String @db.Uuid
  club   Club   @relation(fields: [clubId], references: [id], onDelete: Restrict)

  title       String @db.VarChar(255)
  description String @db.Text

  category EventCategory
  status   EventStatus   @default(DRAFT)

  startDate DateTime  @db.Date
  endDate   DateTime? @db.Date

  startTime String? @db.VarChar(5)
  endTime   String? @db.VarChar(5)

  location String? @db.VarChar(255)
  imageUrl String? @db.Text

  sourceUrl            String?          @db.Text
  // Registration settings
  registrationOpen     Boolean          @default(false)
  registrationDeadline DateTime?        @db.Date
  eligibility          EventEligibility @default(ALL_STUDENTS)

  // NULL means unlimited capacity
  capacity Int?

  // Pricing in the event's currency
  isFree       Boolean @default(true)
  memberFee    Decimal @default(0) @db.Decimal(10, 2)
  nonMemberFee Decimal @default(0) @db.Decimal(10, 2)
  currency     String  @default("ILS") @db.VarChar(3)

  // Student registrations
  registrations EventRegistration[]

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  @@index([clubId, startDate])
  @@index([status, startDate])
}

model EventRegistration {
  id String @id @default(uuid()) @db.Uuid

  eventId   String @db.Uuid
  accountId String @db.Uuid

  event   Event   @relation(fields: [eventId], references: [id], onDelete: Restrict)
  account Account @relation(fields: [accountId], references: [id], onDelete: Restrict)

  status        EventRegistrationStatus @default(CONFIRMED)
  paymentStatus EventPaymentStatus      @default(NOT_REQUIRED)

  amountDue    Decimal   @default(0) @db.Decimal(10, 2)
  payments     Payment[]
  registeredAt DateTime  @default(now()) @db.Timestamptz(6)
  createdAt    DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime  @updatedAt @db.Timestamptz(6)

  // One registration record per student per event.
  // A cancelled registration can be reactivated later.
  @@unique([eventId, accountId])
  @@index([eventId, status])
  @@index([accountId, status])
}

model RefreshSession {
  id        String @id @default(uuid()) @db.Uuid
  accountId String @db.Uuid
  tokenHash String @unique

  createdAt DateTime  @default(now())
  expiresAt DateTime
  revokedAt DateTime?

  account      Account               @relation(fields: [accountId], references: [id], onDelete: Cascade)
  tokenHistory RefreshTokenHistory[]

  @@index([accountId])
  @@index([expiresAt])
}

model RefreshTokenHistory {
  id        String @id @default(uuid()) @db.Uuid
  sessionId String @db.Uuid
  tokenHash String @unique

  createdAt DateTime @default(now())

  session RefreshSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  accountId String    @db.Uuid
  tokenHash String    @unique @db.VarChar(64)
  expiresAt DateTime  @db.Timestamptz(6)
  usedAt    DateTime? @db.Timestamptz(6)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId])
}

model SupervisorProfile {
  id       String @id @default(uuid()) @db.Uuid
  fullName String @db.VarChar(150)

  accountId String  @unique @db.Uuid
  account   Account @relation(fields: [accountId], references: [id], onDelete: Restrict)

  facultyId String  @db.Uuid
  faculty   Faculty @relation(fields: [facultyId], references: [id], onDelete: Restrict)

  clubs Club[]

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  @@index([facultyId])
}

model ClubAdminAssignment {
  id String @id @default(uuid()) @db.Uuid

  clubId             String            @db.Uuid
  accountId          String            @db.Uuid
  boardAppointmentId String?           @db.Uuid
  position           ClubAdminPosition

  assignedAt DateTime  @default(now()) @db.Timestamptz(6)
  revokedAt  DateTime? @db.Timestamptz(6)

  assignedById String  @db.Uuid
  revokedById  String? @db.Uuid

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  club Club @relation(fields: [clubId], references: [id], onDelete: Restrict)

  account Account @relation("ClubAdminStudent", fields: [accountId], references: [id], onDelete: Restrict)

  assignedBy Account @relation("ClubAdminAssignedBy", fields: [assignedById], references: [id], onDelete: Restrict)

  revokedBy Account? @relation("ClubAdminRevokedBy", fields: [revokedById], references: [id], onDelete: Restrict)

  boardAppointment BoardAppointment? @relation(fields: [boardAppointmentId], references: [id], onDelete: Restrict)

  @@index([clubId, revokedAt])
  @@index([accountId, revokedAt])
  @@index([boardAppointmentId])
}

enum ClubAdminPosition {
  PRESIDENT
  SECOND_ADMIN
}

model BoardAppointment {
  id String @id @default(uuid()) @db.Uuid

  clubId    String @db.Uuid
  studentId String @db.Uuid

  position String @db.VarChar(100)

  startDate DateTime  @db.Date
  endDate   DateTime? @db.Date
  endedAt   DateTime? @db.Timestamptz(6)

  club    Club              @relation(fields: [clubId], references: [id], onDelete: Restrict)
  student UniversityStudent @relation(fields: [studentId], references: [id], onDelete: Restrict)

  adminAssignments ClubAdminAssignment[]
  nomination       BoardNomination?
  createdAt        DateTime              @default(now()) @db.Timestamptz(6)
  updatedAt        DateTime              @updatedAt @db.Timestamptz(6)

  @@index([clubId, startDate])
  @@index([studentId])
}

model ClubMembershipSettings {
  id String @id @default(uuid()) @db.Uuid

  clubId String @unique @db.Uuid
  club   Club   @relation(fields: [clubId], references: [id], onDelete: Restrict)

  registrationMode MembershipRegistrationMode @default(ALWAYS_OPEN)

  pendingFirstTimeFee Decimal @db.Decimal(10, 2)
  pendingRenewalFee   Decimal @db.Decimal(10, 2)

  currency String @db.VarChar(3)

  configVersion Int @default(1)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)
}

model ClubMembershipFeeVersion {
  id String @id @default(uuid()) @db.Uuid

  clubId String @db.Uuid
  club   Club   @relation(fields: [clubId], references: [id], onDelete: Restrict)

  firstTimeFee Decimal @db.Decimal(10, 2)
  renewalFee   Decimal @db.Decimal(10, 2)

  currency String @db.VarChar(3)

  effectiveAt DateTime @db.Timestamptz(6)

  createdById String?  @db.Uuid
  createdBy   Account? @relation(fields: [createdById], references: [id], onDelete: Restrict)

  windows      ClubRegistrationWindow[]
  applications MembershipApplication[]
  createdAt    DateTime                 @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime                 @updatedAt @db.Timestamptz(6)

  @@unique([id, clubId], map: "membership_fee_version_id_club_unique")
  @@index([clubId, effectiveAt])
}

model ClubRegistrationWindow {
  id String @id @default(uuid()) @db.Uuid

  clubId String @db.Uuid
  club   Club   @relation(fields: [clubId], references: [id], onDelete: Restrict)

  opensAt  DateTime @db.Timestamptz(6)
  closesAt DateTime @db.Timestamptz(6)

  closedAt              DateTime? @db.Timestamptz(6)
  canceledAt            DateTime? @db.Timestamptz(6)
  effectiveFeeVersionId String?   @db.Uuid

  effectiveFeeVersion ClubMembershipFeeVersion? @relation(fields: [effectiveFeeVersionId, clubId], references: [id, clubId], onDelete: Restrict)
  applications        MembershipApplication[]
  createdAt           DateTime                  @default(now()) @db.Timestamptz(6)
  updatedAt           DateTime                  @updatedAt @db.Timestamptz(6)

  @@index([clubId, opensAt])
  @@index([clubId, closesAt])
}

model Membership {
  id String @id @default(uuid()) @db.Uuid

  clubId String @db.Uuid

  club Club @relation(fields: [clubId], references: [id], onDelete: Restrict)

  studentId String @db.Uuid

  student UniversityStudent @relation(fields: [studentId], references: [id], onDelete: Restrict)

  membershipNumber String @unique @default(dbgenerated("generate_membership_number()")) @db.VarChar(50)

  sourceApplicationId String? @unique @db.Uuid
  sourcePaymentId     String? @unique @db.Uuid

  sourceApplication MembershipApplication? @relation(fields: [sourceApplicationId], references: [id], onDelete: Restrict)

  sourcePayment Payment? @relation(fields: [sourcePaymentId], references: [id], onDelete: Restrict)

  activatedAt DateTime @db.Timestamptz(6)
  expiresAt   DateTime @db.Timestamptz(6)

  confirmedPaymentAt DateTime? @db.Timestamptz(6)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  @@index([studentId, clubId, activatedAt])
  @@index([clubId, expiresAt])
  @@index([clubId, studentId, activatedAt, expiresAt])
}

model MembershipApplication {
  id String @id @default(uuid()) @db.Uuid

  clubId    String @db.Uuid
  studentId String @db.Uuid

  club Club @relation(fields: [clubId], references: [id], onDelete: Restrict)

  student UniversityStudent @relation(fields: [studentId], references: [id], onDelete: Restrict)

  kind   MembershipApplicationKind   @default(ORDINARY)
  status MembershipApplicationStatus @default(PENDING_PAYMENT)

  boardNominationId String? @unique @db.Uuid

  boardNomination BoardNomination? @relation(fields: [boardNominationId], references: [id], onDelete: Restrict)

  feeType      MembershipFeeType
  quotedAmount Decimal           @db.Decimal(10, 2)
  currency     String            @default("ILS") @db.VarChar(3)

  feeVersionId String @db.Uuid

  feeVersion ClubMembershipFeeVersion @relation(fields: [feeVersionId, clubId], references: [id, clubId], onDelete: Restrict)

  registrationWindowId String? @db.Uuid

  registrationWindow ClubRegistrationWindow? @relation(fields: [registrationWindowId], references: [id], onDelete: Restrict)

  registrationModeAtSubmission MembershipRegistrationMode?

  submittedAt           DateTime  @default(now()) @db.Timestamptz(6)
  paymentDeadlineAt     DateTime  @db.Timestamptz(6)
  originalDeadlineAt    DateTime  @db.Timestamptz(6)
  processingGraceEndsAt DateTime? @db.Timestamptz(6)

  paidAt     DateTime?             @db.Timestamptz(6)
  canceledAt DateTime?             @db.Timestamptz(6)
  endReason  ApplicationEndReason?

  payments   Payment[]
  membership Membership?

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  @@index([studentId, clubId, status])
  @@index([clubId, status, paymentDeadlineAt])
  @@index([registrationWindowId, status])
}

model Payment {
  id String @id @default(uuid()) @db.Uuid

  membershipApplicationId String? @db.Uuid
  eventRegistrationId     String? @db.Uuid

  membershipApplication MembershipApplication? @relation(fields: [membershipApplicationId], references: [id], onDelete: Restrict)

  eventRegistration EventRegistration? @relation(fields: [eventRegistrationId], references: [id], onDelete: Restrict)

  method   PaymentMethod
  provider PaymentProvider
  status   PaymentStatus

  amount   Decimal @db.Decimal(10, 2)
  currency String  @default("ILS") @db.VarChar(3)

  referenceKey String @unique @default(uuid()) @db.Uuid

  providerPaymentId String? @db.VarChar(255)

  confirmedAt          DateTime? @db.Timestamptz(6)
  confirmedByAccountId String?   @db.Uuid

  confirmedBy Account? @relation("PaymentConfirmedBy", fields: [confirmedByAccountId], references: [id], onDelete: Restrict)

  attempts   PaymentAttempt[]
  membership Membership?

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  @@unique([provider, providerPaymentId])
  @@index([membershipApplicationId, status])
  @@index([eventRegistrationId, status])
  @@index([status, createdAt])
}

model PaymentAttempt {
  id String @id @default(uuid()) @db.Uuid

  paymentId String @db.Uuid

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Restrict)

  status             PaymentAttemptStatus   @default(INITIATED)
  provider           PaymentProvider
  providerEvents     PaymentProviderEvent[]
  providerAttemptRef String?                @db.VarChar(255)
  idempotencyKey     String                 @unique @db.VarChar(255)

  initiatedAt DateTime @default(now()) @db.Timestamptz(6)

  nominalDeadlineAt     DateTime @db.Timestamptz(6)
  processingGraceEndsAt DateTime @db.Timestamptz(6)

  providerEventAt DateTime? @db.Timestamptz(6)
  receivedAt      DateTime? @db.Timestamptz(6)

  failureCode           String? @db.VarChar(100)
  failureMessageSafe    String? @db.Text
  providerPayloadDigest String? @db.VarChar(255)

  refundReference String? @db.VarChar(255)

  resolvedAt DateTime? @db.Timestamptz(6)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  @@unique([provider, providerAttemptRef])
  @@index([paymentId, status])
  @@index([status, processingGraceEndsAt])
}

model BoardNomination {
  id String @id @default(uuid()) @db.Uuid

  clubId    String @db.Uuid
  studentId String @db.Uuid

  club Club @relation(fields: [clubId], references: [id], onDelete: Restrict)

  student UniversityStudent @relation(fields: [studentId], references: [id], onDelete: Restrict)

  position String @db.VarChar(100)

  proposedStartDate DateTime @db.Date
  proposedEndDate   DateTime @db.Date

  nominatedById String @db.Uuid

  nominatedBy Account @relation("BoardNominatedBy", fields: [nominatedById], references: [id], onDelete: Restrict)

  nominatedAt DateTime @default(now()) @db.Timestamptz(6)
  deadlineAt  DateTime @db.Timestamptz(6)

  status BoardNominationStatus @default(PENDING_PAYMENT)
  reason BoardNominationReason

  qualifiedAt DateTime? @db.Timestamptz(6)
  expiredAt   DateTime? @db.Timestamptz(6)
  withdrawnAt DateTime? @db.Timestamptz(6)

  boardAppointmentId String? @unique @db.Uuid

  boardAppointment BoardAppointment? @relation(fields: [boardAppointmentId], references: [id], onDelete: Restrict)

  application MembershipApplication?

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  @@index([clubId, status, deadlineAt])
  @@index([studentId, status, deadlineAt])
}

model PaymentProviderEvent {
  id String @id @default(uuid()) @db.Uuid

  provider PaymentProvider

  providerEventId String @db.VarChar(255)

  paymentAttemptId String @db.Uuid

  paymentAttempt PaymentAttempt @relation(fields: [paymentAttemptId], references: [id], onDelete: Restrict)

  outcome String @db.VarChar(30)

  status PaymentProviderEventStatus @default(RECEIVED)

  payloadDigest String @db.VarChar(64)

  providerOccurredAt DateTime @db.Timestamptz(6)

  receivedAt DateTime @default(now()) @db.Timestamptz(6)

  processedAt DateTime? @db.Timestamptz(6)

  processingNote String? @db.VarChar(255)

  @@unique([provider, providerEventId])
  @@index([paymentAttemptId, receivedAt])
  @@index([status, receivedAt])
}
