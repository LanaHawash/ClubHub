generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum AccountRole {
  STUDENT
  CLUB
  SUPERVISOR
  DEANSHIP
}

enum AccountStatus {
  ACTIVE
  DISABLED
}

enum ClubClassification {
  GENERAL
  FACULTY_BASED
  MAJOR_BASED
}

enum ClubStatus {
  ACTIVE
  ARCHIVED
}

model Faculty {
  id          String              @id @default(uuid()) @db.Uuid
  name        String              @unique @db.VarChar(150)
  majors      Major[]
  clubs       Club[]
  supervisors SupervisorProfile[]
  createdAt   DateTime            @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime            @updatedAt @db.Timestamptz(6)
}

model Major {
  id                 String              @id @default(uuid()) @db.Uuid
  name               String              @db.VarChar(150)
  facultyId          String              @db.Uuid
  faculty            Faculty             @relation(fields: [facultyId], references: [id], onDelete: Restrict)
  universityStudents UniversityStudent[]
  eligibleClubs      ClubEligibleMajor[]
  createdAt          DateTime            @default(now()) @db.Timestamptz(6)
  updatedAt          DateTime            @updatedAt @db.Timestamptz(6)

  @@unique([facultyId, name])
}

model UniversityStudent {
  id            String              @id @default(uuid()) @db.Uuid
  universityId  String              @unique @db.VarChar(20)
  email         String              @unique @db.VarChar(255)
  fullName      String              @db.VarChar(150)
  majorId       String              @db.Uuid
  major         Major               @relation(fields: [majorId], references: [id], onDelete: Restrict)
  account       Account?
  verifications EmailVerification[]
  createdAt     DateTime            @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime            @updatedAt @db.Timestamptz(6)
}

model Account {
  id                  String               @id @default(uuid()) @db.Uuid
  email               String               @unique @db.VarChar(255)
  passwordHash        String               @db.VarChar(255)
  role                AccountRole
  status              AccountStatus        @default(ACTIVE)
  universityStudentId String?              @unique @db.Uuid
  universityStudent   UniversityStudent?   @relation(fields: [universityStudentId], references: [id], onDelete: Restrict)
  profilePhotoUrl     String?              @db.Text
  eventRegistrations  EventRegistration[]
  refreshSessions     RefreshSession[]
  passwordResets      PasswordResetToken[]
  supervisorProfile   SupervisorProfile?
  createdAt           DateTime             @default(now()) @db.Timestamptz(6)
  updatedAt           DateTime             @updatedAt @db.Timestamptz(6)
}

model EmailVerification {
  id                  String            @id @default(uuid()) @db.Uuid
  universityStudentId String            @db.Uuid
  universityStudent   UniversityStudent @relation(fields: [universityStudentId], references: [id], onDelete: Restrict)
  codeHash            String            @db.VarChar(255)
  expiresAt           DateTime          @db.Timestamptz(6)
  usedAt              DateTime?         @db.Timestamptz(6)
  attemptCount        Int               @default(0)
  createdAt           DateTime          @default(now()) @db.Timestamptz(6)
  updatedAt           DateTime          @updatedAt @db.Timestamptz(6)

  @@index([universityStudentId, expiresAt])
}

model Club {
  id             String              @id @default(uuid()) @db.Uuid
  name           String              @unique @db.VarChar(150)
  description    String              @db.Text
  logoUrl        String?             @db.Text
  classification ClubClassification
  facultyId      String?             @db.Uuid
  faculty        Faculty?            @relation(fields: [facultyId], references: [id], onDelete: Restrict)
  status         ClubStatus          @default(ACTIVE)
  foundedYear    Int?
  contactEmail   String              @db.VarChar(255)
  meetingInfo    String?             @db.Text
  eligibleMajors ClubEligibleMajor[]
  labels         ClubLabel[]
  events         Event[]
  createdAt      DateTime            @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime            @updatedAt @db.Timestamptz(6)

  @@index([status, name])
}

model ClubEligibleMajor {
  id        String   @id @default(uuid()) @db.Uuid
  clubId    String   @db.Uuid
  majorId   String   @db.Uuid
  club      Club     @relation(fields: [clubId], references: [id], onDelete: Restrict)
  major     Major    @relation(fields: [majorId], references: [id], onDelete: Restrict)
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  @@unique([clubId, majorId])
}

model Label {
  id        String      @id @default(uuid()) @db.Uuid
  name      String      @unique @db.VarChar(80)
  clubs     ClubLabel[]
  createdAt DateTime    @default(now()) @db.Timestamptz(6)
  updatedAt DateTime    @updatedAt @db.Timestamptz(6)
}

model ClubLabel {
  id        String   @id @default(uuid()) @db.Uuid
  clubId    String   @db.Uuid
  labelId   String   @db.Uuid
  club      Club     @relation(fields: [clubId], references: [id], onDelete: Restrict)
  label     Label    @relation(fields: [labelId], references: [id], onDelete: Restrict)
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  @@unique([clubId, labelId])
}

enum EventCategory {
  WORKSHOP
  SEMINAR
  CAMPAIGN
  CONFERENCE
  SOCIAL
  VOLUNTEERING
  OTHER
}

enum EventStatus {
  DRAFT
  PUBLISHED
  CANCELLED
}

enum EventEligibility {
  ALL_STUDENTS
  CLUB_MEMBERS
}

enum EventRegistrationStatus {
  CONFIRMED
  PENDING_PAYMENT
  CANCELLED
}

enum EventPaymentStatus {
  NOT_REQUIRED
  PENDING
  PAID
  FAILED
  REFUNDED
}

model Event {
  id String @id @default(uuid()) @db.Uuid

  clubId String @db.Uuid
  club   Club   @relation(fields: [clubId], references: [id], onDelete: Restrict)

  title       String @db.VarChar(255)
  description String @db.Text

  category EventCategory
  status   EventStatus   @default(DRAFT)

  startDate DateTime  @db.Date
  endDate   DateTime? @db.Date

  startTime String? @db.VarChar(5)
  endTime   String? @db.VarChar(5)

  location String? @db.VarChar(255)
  imageUrl String? @db.Text

  sourceUrl            String?          @db.Text
  // Registration settings
  registrationOpen     Boolean          @default(false)
  registrationDeadline DateTime?        @db.Date
  eligibility          EventEligibility @default(ALL_STUDENTS)

  // NULL means unlimited capacity
  capacity Int?

  // Pricing in the event's currency
  isFree       Boolean @default(true)
  memberFee    Decimal @default(0) @db.Decimal(10, 2)
  nonMemberFee Decimal @default(0) @db.Decimal(10, 2)
  currency     String  @default("ILS") @db.VarChar(3)

  // Student registrations
  registrations EventRegistration[]

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  @@index([clubId, startDate])
  @@index([status, startDate])
}

model EventRegistration {
  id String @id @default(uuid()) @db.Uuid

  eventId   String @db.Uuid
  accountId String @db.Uuid

  event   Event   @relation(fields: [eventId], references: [id], onDelete: Restrict)
  account Account @relation(fields: [accountId], references: [id], onDelete: Restrict)

  status        EventRegistrationStatus @default(CONFIRMED)
  paymentStatus EventPaymentStatus      @default(NOT_REQUIRED)

  amountDue Decimal @default(0) @db.Decimal(10, 2)

  registeredAt DateTime @default(now()) @db.Timestamptz(6)
  createdAt    DateTime @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @db.Timestamptz(6)

  // One registration record per student per event.
  // A cancelled registration can be reactivated later.
  @@unique([eventId, accountId])
  @@index([eventId, status])
  @@index([accountId, status])
}

model RefreshSession {
  id        String @id @default(uuid()) @db.Uuid
  accountId String @db.Uuid
  tokenHash String @unique

  createdAt DateTime  @default(now())
  expiresAt DateTime
  revokedAt DateTime?

  account      Account               @relation(fields: [accountId], references: [id], onDelete: Cascade)
  tokenHistory RefreshTokenHistory[]

  @@index([accountId])
  @@index([expiresAt])
}

model RefreshTokenHistory {
  id        String @id @default(uuid()) @db.Uuid
  sessionId String @db.Uuid
  tokenHash String @unique

  createdAt DateTime @default(now())

  session RefreshSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  accountId String    @db.Uuid
  tokenHash String    @unique @db.VarChar(64)
  expiresAt DateTime  @db.Timestamptz(6)
  usedAt    DateTime? @db.Timestamptz(6)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId])
}

model SupervisorProfile {
  id       String @id @default(uuid()) @db.Uuid
  fullName String @db.VarChar(150)

  accountId String  @unique @db.Uuid
  account   Account @relation(fields: [accountId], references: [id], onDelete: Restrict)

  facultyId String  @db.Uuid
  faculty   Faculty @relation(fields: [facultyId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  @@index([facultyId])
}
